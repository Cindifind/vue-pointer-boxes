{
  "name": "vue-pointer-boxes",
  "version": "1.1.2",
  "description": "Vue component: simulated cursors roam the page, then drag elements open from their corners and type text in on scroll.",
  "type": "module",
  "main": "./dist/vue-pointer-boxes.umd.cjs",
  "module": "./dist/vue-pointer-boxes.es.js",
  "exports": {
    ".": {
      "import": "./dist/vue-pointer-boxes.es.js",
      "require": "./dist/vue-pointer-boxes.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "clean": "node scripts/clean.mjs dist",
    "clean:site": "node scripts/clean.mjs dist-site",
    "prebuild": "npm run clean",
    "build": "vite build && vite build --config vite.config.umd.js && node scripts/copy-umd.mjs && node scripts/build-info.mjs",
    "prebuild:site": "npm run clean:site",
    "build:site": "vite build --config vite.config.site.js",
    "check:dist": "node scripts/check-dist.mjs",
    "preview": "vite preview",
    "preview:site": "vite preview --config vite.config.site.js",
    "prepack": "npm run build && npm run check:dist"
  },
  "keywords": [
    "vue",
    "vue3",
    "animation",
    "cursor",
    "drag",
    "scroll",
    "gsap"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "8.3.3",
    "vue": "^3.5.13"
  }
}
